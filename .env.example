# ── 서버 설정 ──────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 데이터 저장 위치 (배포 플랫폼의 영구 볼륨 경로로 지정) ──────
DATA_DIR=./data

# ── API 키 (없어도 서버는 켜집니다. 설정 페이지에서 나중에 입력해도 됩니다) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TYPECAST_API_KEY=

# 모델 이름 (필요시 교체)
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
